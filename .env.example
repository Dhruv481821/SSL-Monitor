NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ssl_monitor
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=15m
TLS_TIMEOUT_MS=10000
DNS_TIMEOUT_MS=5000
CORS_ORIGIN=http://localhost:5173
API_RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_MINUTE=10
MANUAL_CHECK_RATE_LIMIT_PER_MINUTE=20
MONITOR_POLL_INTERVAL_MS=10000
MONITOR_WORKER_CONCURRENCY=5
MONITOR_CHECK_TIMEOUT_MS=15000
MONITOR_RETRY_DELAY_MS=60000
MONITOR_RETRY_MAX_ATTEMPTS=3
MONITOR_STALE_CLAIM_TIMEOUT_MS=120000
MONITOR_BATCH_SIZE=20
MONITOR_INTERVAL_MS=3600000
MONITOR_SHUTDOWN_TIMEOUT_MS=30000

# Phase 06 notifications
NOTIFICATION_TIMEOUT_MS=5000
NOTIFICATION_RETRY_DELAY_MS=1000
NOTIFICATION_MAX_RETRY_DELAY_MS=30000
NOTIFICATION_RETRY_MAX_ATTEMPTS=2
# Optional SMTP email delivery
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
